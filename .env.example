# Copy to .env (never commit the real one).
# The n8n workflows read their keys from n8n credentials, not from this file:
# this list tells you which credentials to create before importing them.

# Recipes — pasted where the workflows say YOUR_SPOONACULAR_API_KEY (workflows 1, 5, 6)
SPOONACULAR_API_KEY=

# LLM — n8n "Header Auth" credential (Authorization: Bearer <key>) + "Groq" credential
GROQ_API_KEY=

# Database — n8n "Airtable Personal Access Token" credential
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=

# Bot — n8n "Telegram" credential
TELEGRAM_BOT_TOKEN=

# Your n8n instance — replaces YOUR_N8N_HOST in workflow 6
N8N_HOST=https://your-n8n-host

# Frontend (Vercel) — Supabase auth
SUPABASE_URL=
SUPABASE_ANON_KEY=

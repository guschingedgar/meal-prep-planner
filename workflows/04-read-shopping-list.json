    {
      "parameters": {
        "jsCode": "// Trois cas distincts : référence inconnue, génération échouée, écriture en cours.\n// Sans le cas 'echec', le site attendrait indéfiniment une liste qui ne viendra pas.\n\nconst d = $input.first().json || {};\nconst reference = $('Read Reference').first().json.reference;\n\nif (!d.Reference) {\n  return [{ json: {\n    ok: false,\n    statut: 'introuvable',\n    reference: reference,\n    message: \"No request matches this reference\"\n  } }];\n}\n\nif (d.Statut === 'echec') {\n  return [{ json: {\n    ok: false,\n    statut: 'echec',\n    reference: reference,\n    message: d.Notes || \"We couldn't build your shopping list\"\n  } }];\n}\n\nreturn [{ json: {\n  ok: true,\n  statut: 'en_preparation',\n  reference: reference,\n  courses: []\n} }];"
      },

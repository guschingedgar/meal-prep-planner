    {
      "parameters": {
        "jsCode": "// Assemble la liste de courses une fois toutes les lignes écrites.\n\nconst reference = $('Read Reference').first().json.reference;\nconst lignes = $input.all()\n  .map(function (i) { return i.json; })\n  .filter(function (r) { return r.Ingredient; });\n\nif (lignes.length === 0) {\n  return [{ json: { ok: true, statut: 'en_preparation', reference: reference, courses: [] } }];\n}\n\nconst courses = lignes.map(function (r) {\n  return {\n    ingredient: r.Ingredient,\n    quantite: r.Quantite || '',\n    rayon: r.Rayon || 'autre',\n    a_acheter: r['A acheter'] === true,\n    cout_estime: r['Cout estime'] || 0,\n    utilise_dans: r['Utilise dans'] || ''\n  };\n});\n\nconst total = courses\n  .filter(function (c) { return c.a_acheter; })\n  .reduce(function (s, c) { return s + (Number(c.cout_estime) || 0); }, 0);\n\nreturn [{\n  json: {\n    ok: true,\n    statut: 'prete',\n    reference: reference,\n    nb_articles: courses.filter(function (c) { return c.a_acheter; }).length,\n    cout_total: Math.round(total * 100) / 100,\n    courses: courses\n  }\n}];"
      },
      "id": "2f031d3c-37b9-4d16-a32a-faf2eb39fe84",
      "name": "Build List",

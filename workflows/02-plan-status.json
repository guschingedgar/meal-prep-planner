    {
      "parameters": {
        "jsCode": "// Distingue trois cas : référence introuvable, génération échouée, génération en cours.\n// Sans ça, le site rappellerait indéfiniment sur une référence qui n'existe pas.\n\nconst d = $input.first().json || {};\n\nif (!d.Reference) {\n  return [{\n    json: {\n      ok: false,\n      statut: 'introuvable',\n      message: \"Aucune demande ne correspond à cette référence\"\n    }\n  }];\n}\n\nconst statut = d.Statut || 'inconnue';\n\nreturn [{\n  json: {\n    ok: true,\n    statut: statut,\n    reference: d.Reference,\n    message: statut === 'echec'\n      ? (d.Notes || 'La génération a échoué')\n      : 'Génération en cours'\n  }\n}];"
      },

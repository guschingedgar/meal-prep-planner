    {
      "parameters": {
        "jsCode": "// Assemble la réponse envoyée au site quand le plan est prêt.\nconst demande = $('Find Request').first().json;\nconst lignes = $input.all().map(function (i) { return i.json; }).filter(function (r) { return r.Creneau; });\n\nconst ORDRE_JOURS = ['Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam', 'Dim'];\nconst ORDRE_MOMENTS = ['midi', 'soir'];\nfunction rang(c) {\n  const p = String(c || '').split('_');\n  return ORDRE_JOURS.indexOf(p[0]) * 2 + ORDRE_MOMENTS.indexOf(p[1]);\n}\n\nconst repas = lignes.map(function (r) {\n  let ingredients = [];\n  try { ingredients = JSON.parse(r.Ingredients || '[]'); } catch (e) { ingredients = []; }\n  const id = Number(r['Spoonacular ID']) || null;\n  return {\n    creneau: r.Creneau,\n    jour: r.Jour,\n    moment: r.Moment,\n    plat: r.Plat,\n    spoonacular_id: id,\n    image: id ? 'https://img.spoonacular.com/recipes/' + id + '-636x393.jpg' : '',\n    lien: r['Lien recette'] || '',\n    pourquoi: r['Pourquoi ce plat'] || '',\n    cout_estime: r['Cout estime'] || 0,\n    calories: Number(r.Calories) || null,\n    proteines: Number(r.Proteines) || null,\n    temps: Number(r.Temps) || null,\n    ingredients: ingredients\n  };\n}).sort(function (a, b) { return rang(a.creneau) - rang(b.creneau); });\n\nconst total = repas.reduce(function (s, r) { return s + (Number(r.cout_estime) || 0); }, 0);\n\nreturn [{\n  json: {\n    ok: true,\n    statut: 'plan_genere',\n    statut_demande: demande.Statut,\n    reference: demande.Reference,\n    budget: demande.Budget,\n    personnes: demande.Personnes,\n    restes: (function () { try { return !!JSON.parse(demande['Payload brut'] || '{}').leftovers; } catch (e) { return false; } })(),\n    creneaux: String(demande.Creneaux || '').split(',').map(function (s) { return s.trim(); }).filter(Boolean),\n    cout_total: Math.round(total * 100) / 100,\n    repas: repas\n  }\n}];\n"
      },
